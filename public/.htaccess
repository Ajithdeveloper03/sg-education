<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sg-education/

  # If the requested url is a file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If the url doesn't end in .html, try adding .html (for trailingSlash: false)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Handle 404s by serving the custom 404.html generated by Next.js
  ErrorDocument 404 /sg-education/404.html
</IfModule>
